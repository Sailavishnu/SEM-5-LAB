#include &lt;stdlib.h&gt;
#include "y.tab.h"
%}

DIGIT   [0-9]
NUMBER  ({DIGIT}+(\.{DIGIT}*)?)|(\.{DIGIT}+)

%%

[ \t\r]+        { /* skip spaces and tabs */ }

{NUMBER}        { yylval.val =3D atof(yytext); return NUMBER; }

"+"             { return '+'; }
"-"             { return '-'; }
"*"             { return '*'; }
"/"             { return '/'; }
"^"             { return '^'; }
"("             { return '('; }
")"             { return ')'; }

\n              { return '\n'; }

.               { printf("Invalid character: %s\n", yytext); return yytext[=
0]; }

%%



%{
#include &lt;stdio.h&gt;
#include &lt;stdlib.h&gt;
#include &lt;string.h&gt;
#include &lt;math.h&gt;

int  yylex(void);
void yyerror(const char *msg);

typedef struct yy_buffer_state *YY_BUFFER_STATE;
extern YY_BUFFER_STATE yy_scan_string(const char *str);
extern void yy_delete_buffer(YY_BUFFER_STATE buf);

int math_error =3D 0;   =20
int syntax_error =3D 0; =20
%}

%union {
    double val;
}

%token &lt;val&gt; NUMBER
%type  &lt;val&gt; expr

%left  '+' '-'
%left  '*' '/'
%right UMINUS
%right '^'

%%

line
    : expr '\n'
        {
            if (!math_error &amp;&amp; !syntax_error)
                printf("Result =3D %g\n", $1);
        }
    | '\n'
        { printf("Nothing entered.\n"); }
    | error '\n'
        { yyerrok; }
    ;

expr
    : NUMBER                { $$ =3D $1; }
    | expr '+' expr         { $$ =3D $1 + $3; }
    | expr '-' expr         { $$ =3D $1 - $3; }
    | expr '*' expr         { $$ =3D $1 * $3; }
    | expr '/' expr
        {
            if ($3 =3D=3D 0) {
                printf("Error: division by zero\n");
                math_error =3D 1;
                $$ =3D 0;
            } else {
                $$ =3D $1 / $3;
            }
        }
    | expr '^' expr
        {
            $$ =3D pow($1, $3);
            if (isnan($$)) {
                printf("Error: result is not a real number\n");
                math_error =3D 1;
                $$ =3D 0;
            }
        }
    | '-' expr %prec UMINUS { $$ =3D -$2; }
    | '(' expr ')'          { $$ =3D $2; }
